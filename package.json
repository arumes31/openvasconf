{
  "name": "openvasconf-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic frontend asset build for the openvasconf container image",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:assets": "esbuild internal/web/static/app.js --minify --legal-comments=none --outfile=dist/app.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
